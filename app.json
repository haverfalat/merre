{
  "expo": {
    "name": "Merre",
    "slug": "merre",
    "version": "1.0.0",
    "icon": "./assets/branding/icon.png",
    "scheme": [
      "merre",
      "tkterkep"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c0e13",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.tkterkep.app"
    },
    "android": {
      "package": "hu.tkterkep.app",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "monochromeImage": "./assets/branding/monochrome-icon.png",
        "backgroundColor": "#0c0e13"
      }
    },
    "web": {
      "output": "server",
      "bundler": "metro",
      "favicon": "./assets/branding/favicon.png",
      "name": "Merre",
      "description": "Merre – Élő magyar közösségi közlekedési térkép"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://merre.bencica.hu"
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show your location on the transit map and find nearby stops."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c0e13",
          "image": "./assets/branding/mark.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Merre to scan boarding Aztec and QR codes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7cae18c4-547b-4c76-a447-c22ef440b75c"
      }
    },
    "owner": "sonacl"
  }
}
