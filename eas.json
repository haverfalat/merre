{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "env": {
        "MERRE_OTA_CHANNEL": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "unsigned": {
      "distribution": "internal",
      "developmentClient": false,
      "ios": {
        "withoutCredentials": true,
        "simulator": false,
        "buildConfiguration": "Release",
        "scheme": "Merre",
        "config": "unsigned-ios.yml"
      },
      "node": "24.3.0",
      "channel": "production"
    },
    "noOTA": {
      "extends": "production",
      "env": {
        "MERRE_NO_OTA": "1"
      }
    },
    "unsigned-noOTA": {
      "extends": "unsigned",
      "env": {
        "MERRE_NO_OTA": "1"
      },
      "ios": {
        "config": "unsigned-ios-noota.yml"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
